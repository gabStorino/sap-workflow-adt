{
  "manifest_version": "0.2",
  "name": "sap-workflow-adt",
  "version": "0.2.0",
  "display_name": "SAP Workflow ADT — ABAP + SAP Business Workflow",
  "description": "Fork of dassian-adt with extra tools for SAP Business Workflow development (package_create, msag_set_messages, wf_class_scaffold, wf_bo_approval_scaffold).",
  "author": {
    "name": "Gabriela Storino",
    "email": "gabriela.storino.ig@gmail.com"
  },
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/index.js"
      ],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    }
  },
  "user_config": {
    "SAP_URL": {
      "type": "string",
      "title": "SAP System URL",
      "description": "SAP system URL including port, e.g. https://d25app.dassian.org:44300",
      "required": true
    },
    "SAP_USER": {
      "type": "string",
      "title": "SAP Username",
      "description": "Your SAP user ID",
      "required": true
    },
    "SAP_PASSWORD": {
      "type": "string",
      "title": "SAP Password",
      "description": "Your SAP password",
      "sensitive": true,
      "required": true
    },
    "SAP_CLIENT": {
      "type": "string",
      "title": "SAP Client",
      "description": "SAP client number (usually 100)",
      "default": "100"
    },
    "SAP_LANGUAGE": {
      "type": "string",
      "title": "SAP Language",
      "description": "SAP logon language",
      "default": "EN"
    }
  },
  "tools": [
    {
      "name": "abap_get_source",
      "description": "Read ABAP source code"
    },
    {
      "name": "abap_get_class_include",
      "description": "Read ABAP class include source code"
    },
    {
      "name": "abap_set_source",
      "description": "Write ABAP source code"
    },
    {
      "name": "abap_create",
      "description": "Create ABAP objects"
    },
    {
      "name": "abap_delete",
      "description": "Delete ABAP objects"
    },
    {
      "name": "abap_activate",
      "description": "Activate ABAP objects"
    },
    {
      "name": "abap_search",
      "description": "Search for ABAP objects"
    },
    {
      "name": "abap_run",
      "description": "Run ABAP code and capture output"
    },
    {
      "name": "abap_table",
      "description": "Read SAP tables and CDS views"
    },
    {
      "name": "abap_query",
      "description": "Execute SQL queries"
    },
    {
      "name": "transport_create",
      "description": "Create transport requests"
    },
    {
      "name": "transport_release",
      "description": "Release transports"
    },
    {
      "name": "abap_syntax_check",
      "description": "Check ABAP syntax"
    },
    {
      "name": "abap_atc_run",
      "description": "Run ATC quality checks"
    },
    {
      "name": "bsp_read_file",
      "description": "Read/list files in a BSP / UI5 application"
    },
    {
      "name": "package_create",
      "description": "Create ABAP packages"
    },
    {
      "name": "msag_set_messages",
      "description": "Write message class messages"
    },
    {
      "name": "wf_class_scaffold",
      "description": "Generate IF_WORKFLOW class + CX_BO_* exceptions"
    },
    {
      "name": "wf_bo_approval_scaffold",
      "description": "Approve/reject workflow on a Z subtype of any BOR object: pre-flight, ABAP objects via ADT, SAP GUI guide"
    }
  ],
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "license": "MIT"
}
